# GitHub OAuth App (Settings > Developer settings > OAuth Apps)
# Authorization callback URL: http://127.0.0.1/api/auth/callback
GITHUB_CLIENT_ID=your_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_oauth_app_client_secret

# Key for encrypting the session cookie (32+ characters). Generate with: openssl rand -base64 32
SESSION_SECRET=your_random_session_secret
